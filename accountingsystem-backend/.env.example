# -----------------------------------------------------------------------------
# AIUR Accounting Backend Environment Template
# -----------------------------------------------------------------------------
# Copy this file to .env and edit values for the target machine.
# Frontend env must point NEXT_PUBLIC_LARAVEL_API_URL to APP_URL below.

APP_NAME="AIUR Accounting"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:3001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logging
# Production: use APP_DEBUG=false and LOG_LEVEL=warning or error.
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database
# PostgreSQL is recommended because some queries use PostgreSQL-style ILIKE.
# For local throwaway testing, DB_CONNECTION=sqlite can still be used.
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=aiur_accounting
DB_USERNAME=postgres
DB_PASSWORD=

# SQLite local alternative:
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/accountingsystem-backend/database/database.sqlite

# -----------------------------------------------------------------------------
# Sanctum Session Authentication
# Browser auth uses Laravel Sanctum session cookies, XSRF-TOKEN, and X-XSRF-TOKEN.
# SANCTUM_STATEFUL_DOMAINS must be hosts only, no http:// or https://.
# Include frontend host/port and backend host/port used by the browser.
# -----------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3001,127.0.0.1,127.0.0.1:3001,127.0.0.1:8000,::1

SESSION_DRIVER=database
SESSION_COOKIE=aiur_laravel_session
SESSION_LIFETIME=525600
SESSION_EXPIRE_ON_CLOSE=false
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Production HTTPS example:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.company.local
# FRONTEND_URL=https://app.company.local
# SANCTUM_STATEFUL_DOMAINS=app.company.local,api.company.local
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=.company.local

# IP/LAN HTTP example:
# APP_URL=http://192.168.1.10:8000
# FRONTEND_URL=http://192.168.1.10:3001
# SANCTUM_STATEFUL_DOMAINS=192.168.1.10:3001,192.168.1.10:8000
# SESSION_SECURE_COOKIE=false
# SESSION_DOMAIN=null

# -----------------------------------------------------------------------------
# Cache, Queue, Broadcast
# Database drivers are simple for onsite deployments. Run migrations before use.
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log
CACHE_STORE=database
QUEUE_CONNECTION=database

# Keep default disk local. Upload endpoints explicitly store public files on the
# public disk under storage/app/public and require: php artisan storage:link
FILESYSTEM_DISK=local

# Optional Redis/Memcached if you switch CACHE_STORE or QUEUE_CONNECTION later.
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail
# Use log locally. Configure SMTP for production password reset / notifications.
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@aiur.local"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# AWS / S3 placeholders. Not used by default onsite local-file deployment.
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
