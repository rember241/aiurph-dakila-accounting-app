# Local development: use the same hostname in browser and backend URLs.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3001
NEXT_PUBLIC_LARAVEL_API_URL=http://127.0.0.1:8000
LARAVEL_API_URL=http://127.0.0.1:8000

# Must match SESSION_COOKIE in the backend .env.
LARAVEL_SESSION_COOKIE_NAME=aiur_laravel_session
